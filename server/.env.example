PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio

# Single-admin auth (see ARCHITECTURE.md "Auth approach")
ADMIN_EMAIL=you@example.com
# Generate with: npm run hash-password -- 'your-password'
ADMIN_PASSWORD_HASH=
# Generate a random secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
