{
  "name": "portfolio-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend API for Mahmoud Mohamed's portfolio — blog, contact form persistence, admin auth.",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "dev": "node --watch dist/index.js",
    "start": "node dist/index.js",
    "migrate": "node dist/db/migrate.js",
    "hash-password": "node scripts/hash-password.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --max-warnings 0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.12.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.9.0",
    "supertest": "^7.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
