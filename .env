# Used by docker-compose.yml for the `api` service (Docker Compose reads
# a .env file at the repo root automatically for ${VAR} substitution —
# this is separate from server/.env, which is for running the backend
# standalone with `npm run dev` outside Docker).
#
# Generate ADMIN_PASSWORD_HASH with: cd server && npm run hash-password -- 'your-password'
# Generate JWT_SECRET with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

